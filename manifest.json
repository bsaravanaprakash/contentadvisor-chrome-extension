{
  "manifest_version": 3,
  "name": "AEM Asset Selector for Kevel",
  "version": "2.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "favicon.png"
  },
  "icons": {
    "16": "favicon.png",
    "32": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.adobeio-static.net/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
